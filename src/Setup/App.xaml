<Application x:Class="Shabpa.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shabpa.Setup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Glass Depth tokens, "night" theme (numbers copied from src/Shabpa/Core/GlassTokens.cs and Palette.cs; this project cannot reference the Kit) -->
        <SolidColorBrush x:Key="Bg" Color="#0A0D18"/>
        <SolidColorBrush x:Key="Text" Color="#EEF1FA"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB3D3"/>
        <SolidColorBrush x:Key="Faint" Color="#8089AD"/>
        <SolidColorBrush x:Key="Accent" Color="#8087FF"/>
        <SolidColorBrush x:Key="Gold" Color="#FFC764"/>
        <SolidColorBrush x:Key="Green" Color="#3DDC97"/>
        <SolidColorBrush x:Key="Red" Color="#FF6B7F"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#243DDC97"/>
        <SolidColorBrush x:Key="RedSoft" Color="#24FF6B7F"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2E8087FF"/>
        <SolidColorBrush x:Key="Line" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="Hi" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="CardFill" Color="#8C1E254C"/>
        <SolidColorBrush x:Key="Card2Fill" Color="#B82E386A"/>
        <SolidColorBrush x:Key="MicaVeil" Color="#CC0C1026"/>
        <SolidColorBrush x:Key="Panel" Color="#8C1E254C"/>
        <SolidColorBrush x:Key="Panel2" Color="#B82E386A"/>
        <Color x:Key="Accent1C">#7B6BF5</Color>
        <Color x:Key="Accent2C">#5C6CFF</Color>
        <Color x:Key="AccentC">#8087FF</Color>
        <Color x:Key="GreenC">#3DDC97</Color>
        <Color x:Key="RedC">#FF6B7F</Color>
        <Color x:Key="GoldC">#FFC764</Color>
        <Color x:Key="PinkC">#FF6B9E</Color>
        <Color x:Key="ShadowC">#99000000</Color>
        <Color x:Key="ShadowHoverC">#BF000000</Color>
        <Color x:Key="ShadowTightC">#66000000</Color>
        <Color x:Key="ShadowSoftC">#45000000</Color>
        <Color x:Key="AccentGlowC">#B35C6CFF</Color>
        <Color x:Key="GreenGlowC">#990A7349</Color>

        <!-- layer 0: four static radial blooms on a dark base (design wall), drawn once -->
        <DrawingBrush x:Key="Wallpaper" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#070A18"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush Center="0.10,0.06" GradientOrigin="0.10,0.06" RadiusX="0.60" RadiusY="0.70">
                                <GradientStop Color="#3B3A9A" Offset="0"/><GradientStop Color="#003B3A9A" Offset="0.6"/><GradientStop Color="#003B3A9A" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush Center="0.94,0.12" GradientOrigin="0.94,0.12" RadiusX="0.55" RadiusY="0.60">
                                <GradientStop Color="#6A2F6B" Offset="0"/><GradientStop Color="#006A2F6B" Offset="0.62"/><GradientStop Color="#006A2F6B" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush Center="0.78,1" GradientOrigin="0.78,1" RadiusX="0.60" RadiusY="0.70">
                                <GradientStop Color="#14566B" Offset="0"/><GradientStop Color="#0014566B" Offset="0.6"/><GradientStop Color="#0014566B" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="0.50" RadiusY="0.50">
                                <GradientStop Color="#4A2A7A" Offset="0"/><GradientStop Color="#004A2A7A" Offset="0.6"/><GradientStop Color="#004A2A7A" Offset="1"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- the main surface's faint gradient -->
        <LinearGradientBrush x:Key="MainBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0DFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <!-- card rim light: bright top hairline fading into the normal hairline -->
        <LinearGradientBrush x:Key="CardRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0"/><GradientStop Color="#17FFFFFF" Offset="0.22"/><GradientStop Color="#17FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B6BF5" Offset="0"/><GradientStop Color="#5C6CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#7B6BF5" Offset="0"/><GradientStop Color="#5C6CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#18AE72" Offset="0"/><GradientStop Color="#0A7349" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF7C8D" Offset="0"/><GradientStop Color="#E0475E" Offset="1"/>
        </LinearGradientBrush>
        <!-- inner top highlight of the primary button -->
        <LinearGradientBrush x:Key="TopHi" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>
        <FontFamily x:Key="Ui">/ShabpaSetup;component/Fonts/#Vazirmatn, Segoe UI</FontFamily>

        <!-- Buttons: secondary (Btn) and primary (BtnPrimary). Hover lift, press scale, glow and sheen come from GlassButton. -->
        <ControlTemplate x:Key="GlassButtonTemplate" TargetType="local:GlassButton">
            <Grid>
                <local:Shadow x:Name="PART_Glow" Radius="12" Blur="22" Spread="-8" OffsetY="8" Layers="14" Opacity="0.9" IsHitTestVisible="False"/>
                <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
                <Border x:Name="hi" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource TopHi}" IsHitTestVisible="False" Visibility="Collapsed"/>
                <Rectangle x:Name="sheen" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35" SpreadMethod="Pad">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="sheenT" X="-1.4"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPrimary" Value="True">
                    <Setter TargetName="hi" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="sheen" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Opacity" Value="0.94"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Btn" TargetType="local:GlassButton">
            <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Card2Fill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="local:GlassButton" BasedOn="{StaticResource Btn}">
            <Setter Property="IsPrimary" Value="True"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- window caption buttons (the installer draws its own title bar) -->
        <Style x:Key="CaptionBtn" TargetType="local:GlassButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:GlassButton">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="local:GlassButton" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:GlassButton">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- option rows: label at the start, the design's toggle at the end (44 px row, hairline between rows) -->
        <Style TargetType="local:Switch">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:Switch">
                        <Border x:Name="row" MinHeight="46" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="0,8,16,8" VerticalAlignment="Center" RecognizesAccessKey="False">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border x:Name="track" Grid.Column="1" Width="42" Height="22" CornerRadius="11" Background="{StaticResource Line}"
                                        BorderBrush="{StaticResource Faint}" BorderThickness="1.5" VerticalAlignment="Center">
                                    <Border x:Name="PART_Knob" Width="14" Height="14" CornerRadius="7" Background="{StaticResource Faint}" HorizontalAlignment="Left" Margin="2.5,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="PART_Knob" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- progress bar: 8 px gradient (design Bar); local:GlassBar glides and can shimmer -->
        <Style x:Key="Bar" TargetType="local:GlassBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:GlassBar">
                        <Grid>
                            <Border Background="{StaticResource Line}" CornerRadius="4"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{StaticResource AccentGradientH}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
