<Window x:Class="Shabpa.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shabpa Setup" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/ShabpaSetup;component/shabpa.ico">
    <Grid Margin="30,26,30,28">
        <StackPanel>
            <DockPanel>
                <Button x:Name="LanguageButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="12,6" FontSize="12" VerticalAlignment="Top" Click="OnLanguage"/>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/ShabpaSetup;component/logo.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20,18" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/>
                    <TextBlock x:Name="PathLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="PathText" FontSize="13" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>

                    <StackPanel x:Name="Options" Margin="0,16,0,0">
                        <CheckBox x:Name="DesktopCheck" IsChecked="True"/>
                        <CheckBox x:Name="AutostartCheck" IsChecked="True"/>
                        <CheckBox x:Name="LaunchCheck" IsChecked="True" Margin="0"/>
                    </StackPanel>
                    <CheckBox x:Name="RemoveDataCheck" Visibility="Collapsed" Margin="0,16,0,0"/>

                    <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="Progress" Style="{StaticResource Bar}"/>
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MainButton" Style="{StaticResource BtnPrimary}" Click="OnMain"/>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Btn}" Padding="22,13" Click="OnClose"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
