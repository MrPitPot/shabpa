<pages:PageBase x:Class="Shabpa.Pages.EnergyPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <UniformGrid Columns="3" Margin="-6,0,-6,0">
            <Border Style="{StaticResource Card}" Margin="6">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                            <TextBlock Text="{s:Tr 'زنده', 'Live'}" Foreground="{StaticResource Green}" FontSize="11.5" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{s:Tr 'مصرف لحظه‌ای', 'Power right now'}" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <TextBlock x:Name="LiveText" FontFamily="{StaticResource Num}" Text="—" Style="{StaticResource Big}" Foreground="{StaticResource Green}" Margin="0,8,0,4" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LiveSub" Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'مصرف ۳۰ روز گذشته', 'Last 30 days'}" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TotalText" FontFamily="{StaticResource Num}" Text="—" Style="{StaticResource Big}" Margin="0,8,0,4" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CoverageText" Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Background="{StaticResource HeroGradient}">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'هزینه‌ی این ۳۰ روز', 'Cost of these 30 days'}" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="CostText" Text="—" Style="{StaticResource Big}" Foreground="{StaticResource Gold}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="CostSub" Style="{StaticResource Label}" FontSize="11.5"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBox x:Name="TariffBox" Style="{StaticResource Input}" Width="110" TextAlignment="Center" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
                    <TextBlock Text="{s:Tr 'تومان / kWh', 'Toman / kWh'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{s:Tr 'ذخیره', 'Save'}" Click="OnSaveTariff"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{s:Tr 'تعرفه‌ی برق', 'Electricity price'}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{s:Tr 'نرخ هر کیلووات‌ساعت رو از قبض خودت وارد کن تا هزینه دقیق بشه.', 'Enter the price per kWh from your bill for an accurate cost.'}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock x:Name="ChartHint" Style="{StaticResource Label}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{s:Tr '۳۰ روز گذشته', 'Last 30 days'}" Style="{StaticResource H2}"/>
                </DockPanel>
                <Grid x:Name="Chart" Height="150" FlowDirection="LeftToRight"/>
                <Grid x:Name="ChartLabels" Height="20" Margin="0,8,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'مصرف به تفکیک حالت', 'Usage by mode'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,10">
            <StackPanel x:Name="ModePanel"/>
        </Border>

        <TextBlock x:Name="Note" Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap" LineHeight="20"/>
    </StackPanel>
</pages:PageBase>
