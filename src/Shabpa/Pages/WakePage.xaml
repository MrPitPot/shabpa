<pages:PageBase x:Class="Shabpa.Pages.WakePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <UniformGrid Columns="2" Margin="-6,0,-6,0">
            <Border Style="{StaticResource Card}" Margin="6">
                <DockPanel>
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource GreenSoft}" DockPanel.Dock="Left">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" Foreground="{StaticResource Green}" HorizontalAlignment="Center" FontSize="18"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{s:Tr 'بیدارباش از خواب و هایبرنیت', 'Wake from sleep and hibernate'}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{s:Tr 'سر ساعت مقرر، سیستم خودش بیدار می‌شه و صفحه روشن می‌شه.', 'At the set time the PC wakes itself and turns the screen on.'}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
                <DockPanel>
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource GoldSoft}" DockPanel.Dock="Left">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" FontSize="18"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{s:Tr 'با «خاموش کردن» بیدار نمی‌شه', 'It cannot wake from a shutdown'}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{s:Tr 'شب‌ها به‌جای خاموشی کامل، سیستم رو بخوابون یا هایبرنیت کن.', 'At night, use sleep or hibernate instead of a full shutdown.'}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="TimerCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,12" Visibility="Collapsed">
            <StackPanel x:Name="TimerPanel"/>
        </Border>

        <TextBlock Text="{s:Tr 'افزودن بیدارباش', 'Add a wake-up'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'ساعت (۲۴ ساعته)', 'Time (24-hour)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBox x:Name="HourBox" Style="{StaticResource NumberInput}" Text="07"/>
                            <TextBlock Text=":" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="MinuteBox" Style="{StaticResource NumberInput}" Text="30"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{s:Tr 'روزهای هفته (خالی یعنی هر روز)', 'Weekdays (none means every day)'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="DayPanel" Orientation="Horizontal" Margin="0,0,0,8"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{s:Tr 'افزودن', 'Add'}" Padding="26,12" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="OnAdd"/>
                </Grid>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'بیدارباش‌های فعال', 'Active wake-ups'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,12">
            <StackPanel x:Name="ListPanel"/>
        </Border>
        <TextBlock Text="{s:Tr 'بیدارباش‌ها توی Task Scheduler ویندوز ثبت می‌شن، پس حتی اگه شب‌پا بسته باشه هم کار می‌کنن.', 'Wake-ups are registered in Windows Task Scheduler, so they work even when Shabpa is closed.'}"
                   Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap"/>
    </StackPanel>
</pages:PageBase>
