<pages:PageBase x:Class="Shabpa.Pages.MemoryPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                            <TextBlock x:Name="FreeText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="{s:Tr 'حافظه‌ای که ویندوز برای باز شدن سریع‌تر برنامه‌ها نگه داشته؛ هر وقت لازم بشه خودش آزادش می‌کنه.', 'Memory Windows keeps so apps reopen faster; it releases it by itself when needed.'}">
                            <TextBlock x:Name="CacheText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'رم در حال استفاده', 'RAM in use'}" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock x:Name="UsedText" FontFamily="{StaticResource Num}" Text="—" FontSize="38" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="TotalText" FontFamily="{StaticResource Num}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,9"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="UsedBar" Style="{StaticResource Bar}" Height="10" Maximum="100" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid Columns="2" Margin="-6,6,-6,0">
            <Border Style="{StaticResource Card}" Margin="6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="TrimButton" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" Content="{s:Tr 'خالی کردن رم', 'Free up RAM'}" Padding="20,11" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="OnTrim"/>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'خالی کردن رم', 'Free up RAM'}" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Text="{s:Tr 'حافظه‌ی بلااستفاده‌ی برنامه‌های باز رو از رم بیرون می‌کشه. برنامه‌ها بسته نمی‌شن؛ فقط دفعه‌ی اول که سراغشون بری یه لحظه کندترن.', 'Pushes the idle memory of running apps out of RAM. Nothing is closed; apps are just a touch slower the first time you return to them.'}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CacheButton" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" Content="{s:Tr 'خالی کردن کش رم', 'Clear RAM cache'}" Padding="20,11" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="OnCache"/>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'خالی کردن کش رم', 'Clear RAM cache'}" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="CacheHint" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <TextBlock x:Name="ResultText" Style="{StaticResource H2}" Foreground="{StaticResource Green}" Margin="4,14,4,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Text="{s:Tr 'خودکار', 'Automatic'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,16,20,10">
            <StackPanel>
                <TextBlock Text="{s:Tr 'وقتی رم از این حد پرتر شد، خودش خالی‌اش کنه (حداکثر هر ۱۰ دقیقه یک بار):', 'Free up RAM by itself when usage passes this level (at most once every 10 minutes):'}" Style="{StaticResource Label}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <WrapPanel x:Name="AutoChips"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap" LineHeight="20"
                   Text="{s:Tr 'ویندوز خودش رم رو مدیریت می‌کنه و رمِ پر به‌خودی‌خود بد نیست. این دکمه‌ها وقتی به درد می‌خورن که قبل از یه بازی یا برنامه‌ی سنگین بخوای جا باز کنی، یا کش بعد از یه کار سنگین خالی نشده باشه.', 'Windows manages RAM on its own, and full RAM is not bad in itself. These buttons help when you want room before a game or heavy app, or when the cache did not shrink after heavy work.'}"/>
    </StackPanel>
</pages:PageBase>
