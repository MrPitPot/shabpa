<pages:PageBase x:Class="Shabpa.Pages.PingPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <!-- live ping -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel MinWidth="250">
                    <TextBlock Text="{s:Tr 'پینگ همین لحظه', 'Ping right now'}" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <TextBlock x:Name="PingText" FontFamily="{StaticResource Num}" Text="—" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                        <TextBlock Text="ms" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" ToolTip="{s:Tr 'میانه‌ی دو دقیقه‌ی اخیر؛ عدد عادی خط تو', 'Median of the last two minutes: what is normal for your line'}">
                            <TextBlock x:Name="BaseText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0" ToolTip="{s:Tr 'پینگ چقدر بالا و پایین می‌پره؛ هر چی کمتر، بازی روون‌تر', 'How much the ping jumps around; lower means smoother games'}">
                            <TextBlock x:Name="JitterText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="{s:Tr 'درصد بسته‌هایی که جوابشون برنگشته', 'Share of packets that never came back'}">
                            <TextBlock x:Name="LossText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="26,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Fixed height: the line is scaled into the box, so a spike can never stretch the page. -->
                    <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="10,10" Height="86" ClipToBounds="True" FlowDirection="LeftToRight">
                        <Grid x:Name="SparkHost">
                            <Polyline x:Name="Spark" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{s:Tr 'مقصد پینگ', 'Ping target'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{s:Tr 'ذخیره', 'Save'}" Margin="8,0,0,0" Padding="14,7" Click="OnSaveHost"/>
                        <TextBox x:Name="HostBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" Padding="10,6" FontSize="13"
                                 ToolTip="{s:Tr 'آی‌پی یا آدرس سرور بازی‌ات رو بذار تا عدد واقعی همون سرور رو ببینی.', 'Enter the IP or address of your game server to see the real figure for it.'}"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- needs admin / driver problem -->
        <Border x:Name="AdminCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,12" Visibility="Collapsed">
            <StackPanel x:Name="AdminPanel"/>
        </Border>

        <!-- in-game guard -->
        <Border x:Name="GuardCard" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <CheckBox x:Name="GuardCheck" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="0" Click="OnGuard" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'محافظت موقع بازی', 'In-game protection'}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{s:Tr 'تا بازی تمام‌صفحه‌ست، آپلود بقیه‌ی برنامه‌ها خودکار سقف می‌خوره تا پینگ نپره؛ بازی که بسته شد همه‌چی آزاد می‌شه.', 'While a full-screen game runs, every other app gets an automatic upload cap so the ping stays steady; it is lifted when the game closes.'}"
                                   Style="{StaticResource Body}" Margin="0,3,12,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{s:Tr 'سقف آپلود هر برنامه موقع بازی:', 'Upload cap per app while gaming:'}" Style="{StaticResource Label}" Margin="0,14,0,8"/>
                <WrapPanel x:Name="GuardChips"/>
                <TextBlock x:Name="GuardStatus" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- per-app traffic -->
        <DockPanel Margin="4,22,4,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <WrapPanel x:Name="SortChips" VerticalAlignment="Center"/>
                <Button x:Name="ClearButton" Style="{StaticResource BtnDanger}" Content="{s:Tr 'حذف همه‌ی محدودیت‌ها', 'Remove all limits'}" Padding="12,7" FontSize="12" Margin="0,0,0,6" Click="OnClear"/>
            </StackPanel>
            <TextBlock Text="{s:Tr 'چی داره اینترنتت رو می‌خوره؟', 'What is using your internet?'}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12.5" Margin="4,0,4,10" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Border Style="{StaticResource Card}" Padding="20,10">
            <StackPanel>
                <Grid x:Name="Header" Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{s:Tr 'برنامه', 'App'}" Style="{StaticResource Label}" FontSize="11.5"/>
                    <TextBlock Grid.Column="1" Text="{s:Tr 'دانلود', 'Download'}" Style="{StaticResource Label}" FontSize="11.5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{s:Tr 'آپلود', 'Upload'}" Style="{StaticResource Label}" FontSize="11.5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{s:Tr 'وضعیت', 'Status'}" Style="{StaticResource Label}" FontSize="11.5" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="AppsPanel"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" Margin="0,8" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap" LineHeight="20"
                   Text="{s:Tr 'روی هر برنامه بزن تا سقف دانلود و آپلودش رو تعیین کنی یا اینترنتش رو کامل ببندی. محدودیت‌ها فقط تا وقتی شب‌پا بازه برقرارن و با بستنش همه‌چی به حالت عادی برمی‌گرده. اگه از فیلترشکن یا پروکسی استفاده می‌کنی، ترافیک هر برنامه هم زیر اسم خودش و هم زیر اسم فیلترشکن دیده می‌شه.', 'Click an app to set its download and upload caps or to cut it off completely. Limits only hold while Shabpa is running; closing it returns everything to normal. If you use a VPN or proxy client, an app shows up both under its own name and under the client.'}"/>
    </StackPanel>
</pages:PageBase>
