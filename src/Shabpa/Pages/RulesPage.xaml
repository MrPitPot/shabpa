<pages:PageBase x:Class="Shabpa.Pages.RulesPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <!-- live status: always visible, turns into the countdown once a rule is active -->
        <Border x:Name="StatusCard" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusBadge" Style="{StaticResource IconBadge}" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" FontSize="18"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                    <ProgressBar x:Name="StatusBar" Style="{StaticResource Bar}" Margin="0,10,0,2" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="StatusClock" Grid.Column="2" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel x:Name="Editor">
            <TextBlock Text="{s:Tr 'قدم ۱: شرط رو انتخاب کن', 'Step 1: pick a condition'}" Style="{StaticResource Section}"/>
            <UniformGrid Columns="4" Margin="-6,0,-6,0">
                <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="ruleKind" Tag="Network" Checked="OnKind" x:Name="KindNetwork">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left"/>
                        <TextBlock Text="{s:Tr 'دانلود یا آپلود تموم شد', 'A download or upload finished'}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{s:Tr 'سرعت شبکه زیر آستانه بمونه', 'Network speed stays low'}" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="ruleKind" Tag="Load" Checked="OnKind" x:Name="KindLoad">
                    <StackPanel>
                        <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left"/>
                        <TextBlock Text="{s:Tr 'کار سنگین تموم شد', 'Heavy work finished'}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{s:Tr 'پردازنده و گرافیک آروم بگیرن', 'CPU and GPU calm down'}" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="ruleKind" Tag="Idle" Checked="OnKind" x:Name="KindIdle">
                    <StackPanel>
                        <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left"/>
                        <TextBlock Text="{s:Tr 'سیستم بی‌استفاده موند', 'The PC sat idle'}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{s:Tr 'بدون موس و کیبورد', 'No mouse or keyboard'}" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="ruleKind" Tag="ProcessExit" Checked="OnKind" x:Name="KindProcess">
                    <StackPanel>
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left"/>
                        <TextBlock Text="{s:Tr 'یه برنامه بسته شد', 'A program closed'}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{s:Tr 'رندر، نصب بازی، بکاپ…', 'Render, game install, backup…'}" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="{s:Tr 'قدم ۲: تنظیم دقیق', 'Step 2: fine-tune'}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="NetworkPanel">
                        <TextBlock Text="{s:Tr 'وقتی کدوم تموم شد؟', 'When which one finishes?'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="DirectionChips"/>
                        <TextBlock Text="{s:Tr 'وقتی سرعتش از این کمتر شد:', 'When its speed drops below:'}" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                        <WrapPanel x:Name="SpeedChips"/>
                    </StackPanel>

                    <StackPanel x:Name="LoadPanel">
                        <TextBlock Text="{s:Tr 'وقتی بار پردازنده و گرافیک هر دو از این کمتر شد:', 'When CPU and GPU load are both below:'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="LoadChips"/>
                    </StackPanel>

                    <StackPanel x:Name="ProcessPanel">
                        <TextBlock Text="{s:Tr 'اسم برنامه (مثلاً steam یا blender.exe):', 'Program name (for example steam or blender.exe):'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <TextBox x:Name="ProcessBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" MaxWidth="340" HorizontalAlignment="Left" TextChanged="OnProcessText"/>
                        <TextBlock Text="{s:Tr 'یا از برنامه‌های باز انتخاب کن:', 'Or pick one that is open:'}" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                        <WrapPanel x:Name="ProcessChips"/>
                    </StackPanel>

                    <TextBlock x:Name="HoldLabel" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                    <WrapPanel x:Name="HoldChips"/>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,14"/>
                    <WrapPanel>
                        <CheckBox x:Name="WaitCheck" Style="{StaticResource Check}" Content="{s:Tr 'اول صبر کن شروع بشه', 'Wait for it to start first'}" Margin="0,0,8,6" Click="OnOption"
                                  ToolTip="{s:Tr 'تا وقتی سرعت یک بار از آستانه بالاتر نرفته، شمارش شروع نمی‌شه.', 'Counting only starts after the speed has been above the threshold once.'}"/>
                        <CheckBox x:Name="RecordCheck" Style="{StaticResource Check}" Content="{s:Tr 'موقع ضبط صفحه دست نگه دار', 'Hold while screen recording'}" Margin="0,0,8,6" Click="OnOption"/>
                        <CheckBox x:Name="GameCheck" Style="{StaticResource Check}" Content="{s:Tr 'موقع بازی دست نگه دار', 'Hold while gaming'}" Margin="0,0,8,6" Click="OnOption"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Tr 'قدم ۳: بعدش چی کار کنه؟', 'Step 3: what should happen then?'}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="20,16,20,10">
                <WrapPanel x:Name="ActionChips"/>
            </Border>
        </StackPanel>

        <Button x:Name="Toggle" Style="{StaticResource BtnBig}" Margin="0,18,0,0" Click="OnToggle"/>
        <TextBlock Text="{s:Tr 'هر قانون فقط یک بار اجرا می‌شه و بعدش خودش خاموش می‌شه. شرط باید پیوسته برقرار بمونه؛ اگه یه لحظه نقض بشه شمارش از صفر شروع می‌شه و قبل از اجرا هم فرصت لغو داری.', 'A rule runs once and then turns itself off. The condition has to hold without a break; one interruption restarts the count, and you can still cancel before it runs.'}"
                   Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap" LineHeight="20"/>
    </StackPanel>
</pages:PageBase>
