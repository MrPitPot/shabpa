<pages:PageBase x:Class="Shabpa.Pages.RemotePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="20,12">
            <StackPanel x:Name="StatusPanel"/>
        </Border>

        <StackPanel x:Name="SetupPanel">
            <TextBlock Text="{s:Tr 'وصل کردن به ربات', 'Linking to the bot'}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{s:Tr 'قدم ۱: ربات شب‌پا رو توی تلگرام باز کن', 'Step 1: open the Shabpa bot in Telegram'}"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{s:Tr 'باز کردن ربات', 'Open the bot'}" Margin="10,0,0,0" Click="OnOpenBot"/>
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontFamily="Consolas" Text="@ShabPa_Bot"/>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                    <TextBlock Style="{StaticResource H2}" Text="{s:Tr 'قدم ۲: این کد رو برای ربات بفرست', 'Step 2: send this code to the bot'}"/>
                    <DockPanel Margin="0,10,0,0">
                        <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,10" DockPanel.Dock="Left">
                            <TextBlock x:Name="CodeText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Gold}" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="CopyButton" Style="{StaticResource Btn}" Content="{s:Tr 'کپی', 'Copy'}" Margin="0,0,8,0" Click="OnCopy"/>
                            <Button x:Name="NewCodeButton" Style="{StaticResource Btn}" Content="{s:Tr 'کد جدید', 'New code'}" Click="OnNewCode"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>
                    <TextBlock x:Name="CodeHint" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="{s:Tr 'حریم خصوصی', 'Privacy'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="TasksToBotCheck" Style="{StaticResource Check}" HorizontalAlignment="Left"
                          Content="{s:Tr 'ربات بتونه عنوان کارهای امروزم رو بهم نشون بده', 'Let the bot show me the titles of today\'s tasks'}" Click="OnTasksToBot"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                           Text="{s:Tr 'پیش‌فرض خاموشه: ربات فقط تعداد کارها رو می‌گه. اگه روشنش کنی، عنوان کارهای امروز از طریق سرور شب‌پا و تلگرام به حساب‌های وصل‌شده می‌رسه.', 'Off by default: the bot only says how many tasks there are. If you turn it on, the titles of today\'s tasks travel through the Shabpa server and Telegram to the linked accounts.'}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'پروکسی', 'Proxy'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{s:Tr 'ذخیره', 'Save'}" Margin="10,0,0,0" Click="OnSaveProxy"/>
                    <TextBox x:Name="ProxyBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" FontFamily="Consolas"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                           Text="{s:Tr 'معمولاً لازم نیست: این کامپیوتر به خود تلگرام وصل نمی‌شه، فقط به سرور شب‌پا. اگه اون هم باز نشد، آدرس پروکسی محلی‌ات رو بنویس؛ مثلاً socks5://127.0.0.1:1080. خالی بذاری از پروکسی خودِ ویندوز استفاده می‌شه.', 'Usually not needed: this PC never talks to Telegram itself, only to the Shabpa server. If that is blocked too, enter your local proxy, for example socks5://127.0.0.1:1080. Leave it empty to use the Windows proxy.'}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'از توی تلگرام چه کارهایی می‌شه کرد', 'What you can do from Telegram'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <TextBlock Style="{StaticResource Body}"
                       Text="{s:Tr 'وضعیت سیستم · خواب · هایبرنیت · خاموش · ری‌استارت · قفل صفحه (همین الان یا با تأخیر) · لغو · خالی کردن رم · کم‌نور کردن صفحه · صدا · حالت شب‌خواب. هر دستور برق اول روی صفحه شمارش معکوس نشون می‌ده، و دستوری که بیشتر از ۳ دقیقه توی راه مونده (مثلاً وقتی سیستم خاموش بوده) هیچ‌وقت اجرا نمی‌شه.', 'PC status · sleep · hibernate · shut down · restart · lock (now or later) · cancel · free RAM · dim the screen · volume · sleep mode. Every power command first shows a countdown on screen, and a command that waited more than 3 minutes (for example while the PC was off) never runs.'}"/>
        </Border>
    </StackPanel>
</pages:PageBase>
