<pages:PageBase x:Class="Shabpa.Pages.HomePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="26,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Greeting" Style="{StaticResource H1}" FontSize="24"/>
                    <TextBlock x:Name="DateText" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{s:Tr 'از آخرین روشن‌شدن', 'Since it last turned on'}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="UptimeText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Margin="4,20,4,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="WattsText" Style="{StaticResource Label}" FontFamily="{StaticResource Num}" FlowDirection="LeftToRight" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{s:Tr 'زنده', 'Live'}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{s:Tr 'وضعیت زنده سیستم', 'Live system status'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
        </DockPanel>
        <UniformGrid Columns="4" Margin="-6,0,-6,0">
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'شبکه', 'Network'}" Style="{StaticResource Label}"/>
                    <DockPanel Margin="0,10,0,10">
                        <TextBlock x:Name="NetSide" DockPanel.Dock="Right" FontFamily="{StaticResource Num}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <TextBlock x:Name="NetBig" FontFamily="{StaticResource Num}" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                            <TextBlock x:Name="NetUnit" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="NetBar" Style="{StaticResource Bar}" Maximum="100" Foreground="{StaticResource Green}"/>
                    <TextBlock x:Name="NetNote" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'حافظه', 'Memory'}" Style="{StaticResource Label}"/>
                    <DockPanel Margin="0,10,0,10">
                        <TextBlock x:Name="RamSide" DockPanel.Dock="Right" FontFamily="{StaticResource Num}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <TextBlock x:Name="RamBig" FontFamily="{StaticResource Num}" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                            <TextBlock x:Name="RamUnit" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="RamBar" Style="{StaticResource Bar}" Maximum="100" Foreground="{StaticResource Green}"/>
                    <TextBlock x:Name="RamNote" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'پردازنده', 'Processor'}" Style="{StaticResource Label}"/>
                    <DockPanel Margin="0,10,0,10">
                        <TextBlock x:Name="CpuSide" DockPanel.Dock="Right" FontFamily="{StaticResource Num}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <TextBlock x:Name="CpuBig" FontFamily="{StaticResource Num}" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                            <TextBlock x:Name="CpuUnit" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="CpuBar" Style="{StaticResource Bar}" Maximum="100" Foreground="{StaticResource Green}"/>
                    <TextBlock x:Name="CpuNote" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="{s:Tr 'کارت گرافیک', 'Graphics card'}" Style="{StaticResource Label}"/>
                    <DockPanel Margin="0,10,0,10">
                        <TextBlock x:Name="GpuSide" DockPanel.Dock="Right" FontFamily="{StaticResource Num}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                            <TextBlock x:Name="GpuBig" FontFamily="{StaticResource Num}" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                            <TextBlock x:Name="GpuUnit" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,6"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="GpuBar" Style="{StaticResource Bar}" Maximum="100" Foreground="{StaticResource Green}"/>
                    <TextBlock x:Name="GpuNote" Style="{StaticResource Label}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="{s:Tr 'بعدی چیه؟', 'What is next?'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,12">
            <StackPanel x:Name="NextPanel"/>
        </Border>

        <TextBlock Text="{s:Tr 'میان‌بر', 'Shortcuts'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{s:Tr 'چی کار کنه؟', 'What should it do?'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,14,6"/>
                    <WrapPanel x:Name="ActionChips"/>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Btn}" Content="{s:Tr '۳۰ دقیقه‌ی دیگه', 'In 30 minutes'}" Margin="0,0,8,8" Tag="30" Click="OnPreset"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr '۱ ساعت دیگه', 'In 1 hour'}" Margin="0,0,8,8" Tag="60" Click="OnPreset"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr '۲ ساعت دیگه', 'In 2 hours'}" Margin="0,0,8,8" Tag="120" Click="OnPreset"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr 'وقتی دانلود تموم شد', 'When the download finishes'}" Margin="0,0,8,8" Click="OnAfterDownload"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr 'وقتی نیم ساعت بی‌استفاده موند', 'After 30 idle minutes'}" Margin="0,0,8,8" Click="OnWhenIdle"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Click="OnLock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{s:Tr 'قفل صفحه', 'Lock screen'}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RamButton" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="OnFreeRam">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{s:Tr 'خالی کردن رم', 'Free up RAM'}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="TodayText" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</pages:PageBase>
