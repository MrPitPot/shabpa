<pages:PageBase x:Class="Shabpa.Pages.SettingsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{s:Tr 'زبان و ظاهر', 'Language and look'}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <TextBlock Text="{s:Tr 'زبان', 'Language'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="LanguageChips"/>
                <TextBlock Text="{s:Tr 'تم رنگی', 'Colour theme'}" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                <WrapPanel x:Name="ThemePanel"/>
                <TextBlock Text="{s:Tr 'شیشه‌ای (ویندوز ۱۱)', 'Glass (Windows 11)'}" Style="{StaticResource Label}" Margin="0,10,0,8"
                           ToolTip="{s:Tr 'پس‌زمینه‌ی پنجره نیمه‌شفاف می‌شه و رنگ میز کار یا عکس پس‌زمینه کم‌رنگ از زیرش پیداست. در حالت «رم کمتر» خاموشه.', 'The window background turns translucent and your wallpaper shows faintly through. Off in “Use less RAM” mode.'}"/>
                <WrapPanel x:Name="GlassChips"/>
                <Grid x:Name="GlassLevelRow" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{s:Tr 'غلظت شیشه', 'Glass tint'}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    <Slider x:Name="GlassLevelSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource Slide}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GlassLevelText" Grid.Column="2" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                </Grid>
                <TextBlock Text="{s:Tr 'با عوض کردن زبان یا تم، برنامه یک لحظه بسته و دوباره باز می‌شه.', 'Changing the language or theme briefly closes and reopens the app.'}" Style="{StaticResource Label}" FontSize="11.5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{s:Tr 'رفتار برنامه', 'Behaviour'}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <CheckBox x:Name="AutostartCheck" Style="{StaticResource Check}" Content="{s:Tr 'همراه ویندوز اجرا بشه', 'Start with Windows'}" Margin="0,0,8,6" Click="OnBehaviour"
                              ToolTip="{s:Tr 'بدون این، بعد از روشن شدن سیستم زمان‌بندی‌ها و قانون‌ها کار نمی‌کنن تا خودت برنامه رو باز کنی.', 'Without this, schedules and rules do nothing after a reboot until you open the app yourself.'}"/>
                    <CheckBox x:Name="ConfirmCheck" Style="{StaticResource Check}" Content="{s:Tr 'قبل از هر کار تایید بگیر', 'Ask before every action'}" Margin="0,0,8,6" Click="OnBehaviour"
                              ToolTip="{s:Tr 'قبل از زمان‌بندی، حذف، قفل کردن و خالی کردن رم یه پیام تایید با زمان دقیق نشون می‌ده.', 'Shows a confirmation with the exact time before scheduling, deleting, locking or freeing RAM.'}"/>
                    <CheckBox x:Name="ReportCheck" Style="{StaticResource Check}" Content="{s:Tr 'بعد از هر بازی گزارش بده', 'Report after every game'}" Margin="0,0,8,6" Click="OnBehaviour"
                              ToolTip="{s:Tr 'فریم بر ثانیه، پینگ، دمای کارت و حجم اینترنت بازی؛ با تلگرام هم می‌فرسته.', 'Frame rate, ping, GPU temperature and the data the game used; also sent to Telegram.'}"/>
                    <CheckBox x:Name="AnimCheck" Style="{StaticResource Check}" Content="{s:Tr 'انیمیشن‌ها', 'Animations'}" Margin="0,0,8,6" Click="OnBehaviour"
                              ToolTip="{s:Tr 'حرکت نرم صفحه‌ها و دکمه‌ها. اگه ویندوز انیمیشن‌ها رو خاموش کرده باشه، این‌جا هم خاموش می‌مونن.', 'Smooth motion for pages and buttons. If Windows has animations turned off, they stay off here too.'}"/>
                    <CheckBox x:Name="SoundCheck" Style="{StaticResource Check}" Content="{s:Tr 'صدای ریز موقع حرکت ماوس (آزمایشی)', 'Tiny sounds on hover (experimental)'}" Margin="0,0,8,6" Click="OnBehaviour"
                              ToolTip="{s:Tr 'یه تیک خیلی آروم موقع رفتن ماوس روی گزینه‌ها، یه کلیک و یه زنگ کوتاه برای اعلان‌ها. موقع بازی و در حالت «رم کمتر» ساکته.', 'A very soft tick when the mouse moves over options, a click and a short chime for notices. Silent during games and in “Use less RAM” mode.'}"/>
                    <CheckBox x:Name="LowMemoryCheck" Style="{StaticResource Check}" Content="{s:Tr 'رم کمتر', 'Use less RAM'}" Margin="0,0,8,6" Click="OnLowMemory"
                              ToolTip="{s:Tr 'کم‌مصرف‌ترین حالت: انیمیشن‌ها و صدای رابط خاموش می‌شن، پنجره به‌جای کارت گرافیک با پردازنده کشیده می‌شه (حدود ۴۵ مگ رم کمتر) و حافظه‌ی بلااستفاده زودتر برگردونده می‌شه. برنامه دوباره باز می‌شه.', 'The lightest mode: animations and interface sounds are off, the window is drawn by the processor instead of the graphics card (about 45 MB less RAM) and unused memory is handed back sooner. The app restarts.'}"/>
                    <CheckBox x:Name="MinimizedCheck" Style="{StaticResource Check}" Content="{s:Tr 'همیشه بی‌صدا کنار ساعت باز بشه', 'Always start quietly in the tray'}" Margin="0,0,8,6" Click="OnBehaviour"/>
                </WrapPanel>
                <TextBlock x:Name="AutostartHint" Style="{StaticResource Label}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{s:Tr 'قبل از اجرای دستورهای زمان‌بندی‌شده چقدر فرصت لغو بده؟', 'How long to wait for a cancel before a scheduled command runs?'}" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                <WrapPanel x:Name="CountdownChips"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{s:Tr 'تخمین مصرف برق', 'Power estimate'}" Style="{StaticResource H2}"/>
                <TextBlock x:Name="PowerHint" Style="{StaticResource Body}" Margin="0,4,0,12"/>
                <UniformGrid Columns="4" Margin="-6,0,-6,0">
                    <StackPanel Margin="6">
                        <TextBlock Text="{s:Tr 'بیشترین توان گرافیک (وات)', 'GPU maximum (W)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="GpuMaxBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="{s:Tr 'توان گرافیک در بیکاری', 'GPU when idle (W)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="GpuIdleBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="{s:Tr 'بقیه‌ی قطعات (وات)', 'Everything else (W)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="BaseBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="6" x:Name="CpuMaxPanel">
                        <TextBlock Text="{s:Tr 'بیشترین توان پردازنده', 'CPU maximum (W)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="CpuMaxBox" Style="{StaticResource Input}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
                <Button Style="{StaticResource BtnPrimary}" Content="{s:Tr 'ذخیره', 'Save'}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="26,9" Click="OnSavePower"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{s:Tr 'برنامه‌های ضبط صفحه', 'Screen recorders'}" Style="{StaticResource H2}"/>
                <TextBlock Text="{s:Tr 'وقتی یکی از این‌ها باز باشه، قانون‌هایی که «موقع ضبط صفحه دست نگه دار» دارن صبر می‌کنن. اسم‌ها رو با ویرگول جدا کن.', 'While one of these is running, rules set to hold during screen recording wait. Separate names with commas.'}"
                           Style="{StaticResource Body}" Margin="0,4,0,10"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{s:Tr 'ذخیره', 'Save'}" Margin="10,0,0,0" Click="OnSaveRecorders"/>
                    <TextBox x:Name="RecorderBox" Style="{StaticResource Input}" FlowDirection="LeftToRight"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{s:Tr 'ذخیره و بازیابی تنظیمات', 'Back up and restore settings'}" Style="{StaticResource H2}"/>
                <TextBlock Text="{s:Tr 'یه فایل از تنظیمات (و اگه بخوای پروفایل‌ها و کارها) می‌سازه که روی سیستم دیگه یا بعد از نصب دوباره برمی‌گردونیش. اطلاعات اتصال به ربات و کلیدهای خصوصی توش نیست.', 'Makes a file of your settings (and, if you choose, profiles and tasks) to bring back on another PC or after a reinstall. Bot link details and private keys are not included.'}"
                           Style="{StaticResource Body}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <CheckBox x:Name="BackupProfiles" Style="{StaticResource Check}" IsChecked="True" Content="{s:Tr 'پروفایل‌ها و خودکارسازی‌ها هم باشن', 'Include profiles and automations'}" HorizontalAlignment="Left"/>
                <CheckBox x:Name="BackupTasks" Style="{StaticResource Check}" Content="{s:Tr 'کارها (لیست کارهای من) هم باشن', 'Include my tasks'}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource Btn}" Content="{s:Tr 'ذخیره‌ی تنظیمات…', 'Save settings…'}" Margin="0,0,8,0" Click="OnExportSettings"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr 'بازیابی از فایل…', 'Restore from a file…'}" Click="OnImportSettings"/>
                </WrapPanel>
                <TextBlock x:Name="BackupHint" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{s:Tr 'اعلان‌های اخیر', 'Recent notices'}" Style="{StaticResource H2}"/>
                <TextBlock Text="{s:Tr 'فقط توی حافظه نگه داشته می‌شن و با بستن برنامه پاک می‌شن.', 'Kept in memory only and gone when the app closes.'}" Style="{StaticResource Label}" Margin="0,3,0,0"/>
                <StackPanel x:Name="NoticeList" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{s:Tr 'پوشه‌ی داده‌ها', 'Data folder'}" VerticalAlignment="Center" Click="OnOpenFolder"/>
                <StackPanel>
                    <TextBlock Text="{s:Tr 'شب‌پا', 'Shabpa'}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{s:Tr 'ساخته‌ی Mr.PitPot. داده‌هات روی همین سیستم می‌مونن. فقط چیزهایی که خودت روشن می‌کنی به اینترنت وصل می‌شن: بررسی به‌روزرسانی (GitHub)، آب‌وهوا، ربات تلگرام و ارسال تیکت پشتیبانی. صدای میکروفون (نویزگیر) فقط لحظه‌ای توی حافظه پردازش می‌شه و ذخیره نمی‌شه؛ نورپردازی هم فقط با OpenRGB روی همین کامپیوتر حرف می‌زنه. «یادگیری دستی» هم فقط جای کلیک‌های ماوس روی پنجره‌ی لانچر رو نگه می‌داره، نه کلید یا متن.', 'Made by Mr.PitPot. Your data stays on this PC. Only what you switch on uses the internet: the update check (GitHub), weather, the Telegram bot and support tickets. Microphone sound (noise suppression) is only processed for a moment in memory and never stored; Lighting only talks to OpenRGB on this PC. “Teach by hand” keeps only where you clicked in a launcher window, never keys or text.'}" Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</pages:PageBase>
