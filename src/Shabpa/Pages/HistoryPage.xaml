<pages:PageBase x:Class="Shabpa.Pages.HistoryPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SummaryBadge" Style="{StaticResource IconBadge}" Background="{StaticResource GreenSoft}" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryIcon" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Green}" HorizontalAlignment="Center" FontSize="18"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="SummaryPills" Orientation="Horizontal"/>
                    <Button Style="{StaticResource Btn}" Content="{s:Tr 'بازبینی مجدد', 'Refresh'}" Margin="10,0,0,0" Click="OnReload"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{s:Tr 'هفته‌ی گذشته', 'The past week'}" Style="{StaticResource Section}"/>
        <UniformGrid x:Name="DayTiles" Columns="7" Margin="-5,0,-5,0"/>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="DayTitle" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                <StackPanel x:Name="Timeline"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'چی نمی‌ذاره سیستم بخوابه', 'What keeps the PC awake'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,12">
            <StackPanel x:Name="BlockerPanel"/>
        </Border>
    </StackPanel>
</pages:PageBase>
