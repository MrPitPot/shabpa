<pages:PageBase x:Class="Shabpa.Pages.PowerPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:s="clr-namespace:Shabpa"
                xmlns:pages="clr-namespace:Shabpa.Pages">
    <StackPanel>
        <UniformGrid Columns="4" Margin="-6,0,-6,0" x:Name="Tiles">
            <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="powerAction" Tag="Sleep" Checked="OnPick">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:Tr 'خواب', 'Sleep'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="{s:Tr 'سریع برمی‌گرده', 'Back in seconds'}" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="powerAction" Tag="Hibernate" Checked="OnPick">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:Tr 'هایبرنیت', 'Hibernate'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="{s:Tr 'بدون مصرف برق', 'Uses no power'}" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="powerAction" Tag="Shutdown" Checked="OnPick" IsChecked="True">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:Tr 'خاموش کردن', 'Shut down'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="{s:Tr 'همه‌چی بسته می‌شه', 'Everything closes'}" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Tile}" Margin="6" GroupName="powerAction" Tag="Restart" Checked="OnPick">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:Tr 'راه‌اندازی مجدد', 'Restart'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="{s:Tr 'خاموش و دوباره روشن', 'Off and on again'}" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <WrapPanel x:Name="ModeChips"/>

                <StackPanel x:Name="AfterPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AfterHours" Style="{StaticResource NumberInput}" Text="0" TextChanged="OnInput"/>
                        <TextBlock Text="{s:Tr 'ساعت و', 'h and'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox x:Name="AfterMinutes" Style="{StaticResource NumberInput}" Text="30" TextChanged="OnInput"/>
                        <TextBlock Text="{s:Tr 'دقیقه‌ی دیگه', 'min from now'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0"/>
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Btn}" Content="{s:Tr '۱۵ دقیقه', '15 min'}" Tag="15" Click="OnQuick" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="{s:Tr '۳۰ دقیقه', '30 min'}" Tag="30" Click="OnQuick" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="{s:Tr '۱ ساعت', '1 hour'}" Tag="60" Click="OnQuick" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="{s:Tr '۲ ساعت', '2 hours'}" Tag="120" Click="OnQuick" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="{s:Tr '۴ ساعت', '4 hours'}" Tag="240" Click="OnQuick"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="AtPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBox x:Name="AtHour" Style="{StaticResource NumberInput}" Text="01" TextChanged="OnInput"/>
                            <TextBlock Text=":" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="AtMinute" Style="{StaticResource NumberInput}" Text="30" TextChanged="OnInput"/>
                        </StackPanel>
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{s:Tr 'تکرار در روزهای هفته (خالی یعنی فقط یک بار)', 'Repeat on weekdays (none means just once)'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <StackPanel x:Name="DayPanel" Orientation="Horizontal"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="Summary" Style="{StaticResource Body}" Margin="0,14,0,0"/>
                <Button x:Name="Go" Style="{StaticResource BtnBig}" Margin="0,14,0,0" Click="OnGo"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Tr 'دستورهای در صف', 'Queued commands'}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="20,12">
            <StackPanel x:Name="QueuePanel"/>
        </Border>
        <TextBlock Text="{s:Tr 'همین دستورها از ربات تلگرام هم در دسترسه. قبل از اجرای هر دستور زمان‌بندی‌شده، یه شمارش معکوس با دکمه‌ی لغو می‌بینی.', 'The same commands work from the Telegram bot. Every scheduled command shows a countdown with a cancel button first.'}"
                   Style="{StaticResource Label}" Margin="4,12,4,0" TextWrapping="Wrap"/>
    </StackPanel>
</pages:PageBase>
