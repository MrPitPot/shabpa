<Window x:Class="Shabpa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Shabpa"
        Title="{s:Tr 'شب‌پا', 'Shabpa'}" Width="1140" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgGradient}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/shabpa.ico">
    <Grid x:Name="Root" Background="{StaticResource BgGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SideGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{s:Tr 'شب‌پا', 'Shabpa'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{s:Tr 'نگهبان شبانه‌ی سیستم', 'Your PC night watch'}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="DryRunPill" Style="{StaticResource Pill}" Background="{StaticResource GoldSoft}" HorizontalAlignment="Stretch"
                            Margin="0,0,0,10" Visibility="Collapsed"
                            ToolTip="{s:Tr 'دستورهای برق اجرا نمی‌شن، فقط شبیه‌سازی می‌شن.', 'Power commands are only simulated, never run.'}">
                        <TextBlock Text="{s:Tr 'حالت آزمایشی', 'Test mode'}" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource Green}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideWatts" FontFamily="{StaticResource Num}" Text="— W" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <StackPanel x:Name="SideGame" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock x:Name="SideGameName" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SideGameTime" Style="{StaticResource Label}" FontFamily="{StaticResource Num}" FontSize="12" FlowDirection="LeftToRight" HorizontalAlignment="Left" Foreground="{StaticResource Green}"/>
                            </StackPanel>
                            <TextBlock x:Name="SideNext" Style="{StaticResource Label}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-6,0" Padding="0,0,6,0">
                <StackPanel x:Name="NavPanel">
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE80F;" Content="{s:Tr 'خانه', 'Home'}" x:Name="NavHome" Checked="OnNav"/>
                    <TextBlock Text="{s:Tr 'سیستم و برق', 'System &amp; power'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="12,14,0,4" Opacity="0.85"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="{s:Tr 'کنترل سیستم', 'System control'}" x:Name="NavSystem" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE708;" Content="{s:Tr 'آسایش و استراحت', 'Comfort &amp; rest'}" x:Name="NavComfort" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE768;" Content="{s:Tr 'پروفایل‌ها', 'Profiles'}" x:Name="NavProfiles" Checked="OnNav"/>
                    <TextBlock Text="{s:Tr 'بازی و شبکه', 'Gaming &amp; network'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="12,14,0,4" Opacity="0.85"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="{s:Tr 'اورلی بازی', 'Game overlay'}" x:Name="NavGaming" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE701;" Content="{s:Tr 'پایداری پینگ', 'Ping stability'}" x:Name="NavPing" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE774;" Content="{s:Tr 'دی‌ان‌اس', 'DNS'}" x:Name="NavDns" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE896;" Content="{s:Tr 'دانلود زمان‌بندی‌شده', 'Scheduled download'}" x:Name="NavDownload" Checked="OnNav"/>
                    <TextBlock Text="{s:Tr 'نگهداری', 'Maintenance'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="12,14,0,4" Opacity="0.85"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="{s:Tr 'فایل و پشتیبان', 'Files &amp; backup'}" x:Name="NavFiles" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE95E;" Content="{s:Tr 'سلامت و امنیت', 'Health &amp; security'}" x:Name="NavHealth" Checked="OnNav"/>
                    <TextBlock Text="{s:Tr 'روزمره', 'Everyday'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="12,14,0,4" Opacity="0.85"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE73A;" Content="{s:Tr 'کارها و تمرکز', 'Tasks &amp; focus'}" x:Name="NavTasks" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE720;" Content="{s:Tr 'میکروفون', 'Microphone'}" x:Name="NavMic" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE706;" Content="{s:Tr 'آب و هوا', 'Weather'}" x:Name="NavWeather" Checked="OnNav"/>
                    <TextBlock Text="{s:Tr 'برنامه', 'App'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="12,14,0,4" Opacity="0.85"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE897;" Content="{s:Tr 'پشتیبانی', 'Support'}" x:Name="NavSupport" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE895;" Content="{s:Tr 'به‌روزرسانی', 'Updates'}" x:Name="NavUpdate" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE713;" Content="{s:Tr 'تنظیمات', 'Settings'}" x:Name="NavSettings" Checked="OnNav"/>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Margin="34,26,34,10">
                <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
                <TextBlock x:Name="PageSub" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="Host" Margin="34,6,24,30" MaxWidth="1000" HorizontalAlignment="Stretch" Focusable="False"/>
            </ScrollViewer>

            <!-- in-app notice: shown here instead of a tray balloon while the window is open -->
            <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,22" MaxWidth="560"
                    Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,12"
                    Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="OnToastClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastMove"/>
                </Border.RenderTransform>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" Style="{StaticResource H2}" FontSize="14"/>
                        <TextBlock x:Name="ToastText" Style="{StaticResource Label}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
