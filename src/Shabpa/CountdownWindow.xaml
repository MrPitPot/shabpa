<Window x:Class="Shabpa.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Shabpa"
        xmlns:kit="clr-namespace:Shabpa.Kit"
        Title="Shabpa" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        FontFamily="{StaticResource Ui}" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <!-- The flyout of the design: near-opaque sheet, rim light, layered shadow (kit:Shadow, no DropShadowEffect). The margin is
         the room the shadow needs inside the transparent window. -->
    <Grid x:Name="Root">
    <Grid Margin="36,24,36,46" x:Name="Sheet" RenderTransformOrigin="0.5,0.5">
        <kit:Shadow Radius="22" Blur="30" Spread="-14" OffsetY="14" Layers="9" Color="{StaticResource ShadowC}" IsHitTestVisible="False"/>
        <kit:Shadow Radius="22" Blur="3" Spread="0" OffsetY="1" Layers="3" Color="{StaticResource ShadowTightC}" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource FlyoutFill}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1" CornerRadius="22"
                MouseLeftButtonDown="OnDrag">
            <StackPanel Margin="28,26,28,24">
                <ContentControl x:Name="BadgeHost" HorizontalAlignment="Center" Focusable="False"/>
                <TextBlock x:Name="ReasonText" Style="{StaticResource Label}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" LineHeight="32" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,14"/>

                <Grid Width="176" Height="176" HorizontalAlignment="Center">
                    <kit:RingGauge x:Name="Ring" ViewSize="200" RingRadius="84" Thickness="12" Ticks="False" Knob="False"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SecondsText" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"
                                   LineHeight="56" LineStackingStrategy="BlockLineHeight" FlowDirection="LeftToRight" RenderTransformOrigin="0.5,0.5"/>
                        <TextBlock Text="{s:Tr 'ثانیه', 'seconds'}" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>

                <Button Content="{s:Tr 'لغو', 'Cancel'}" Style="{StaticResource BtnBig}" Margin="0,22,0,0" Click="OnCancel" IsCancel="True" kit:Skin.Corner="24"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{s:Tr '۱۰ دقیقه بعد', 'In 10 minutes'}" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Padding="12,11" Click="OnLater"/>
                    <Button Grid.Column="2" Content="{s:Tr 'همین حالا', 'Do it now'}" Style="{StaticResource BtnDanger}" HorizontalAlignment="Stretch" Padding="12,11" Click="OnNow"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
