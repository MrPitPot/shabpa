<Window x:Class="Shabpa.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Shabpa"
        Title="Shabpa" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        FontFamily="{StaticResource Ui}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="28,26,28,24">
            <TextBlock x:Name="ReasonText" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" HorizontalAlignment="Center" Margin="0,6,0,18"/>

            <Grid Width="150" Height="150" HorizontalAlignment="Center">
                <Ellipse Stroke="{StaticResource Panel3}" StrokeThickness="8"/>
                <Path x:Name="Arc" Stroke="{StaticResource AccentGradient}" StrokeThickness="8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SecondsText" FontSize="48" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{s:Tr 'ثانیه', 'seconds'}" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                </StackPanel>
            </Grid>

            <Button Content="{s:Tr 'لغو', 'Cancel'}" Style="{StaticResource BtnBig}" Margin="0,22,0,0" Click="OnCancel" IsCancel="True"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="{s:Tr '۱۰ دقیقه بعد', 'In 10 minutes'}" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Padding="12,11" Click="OnLater"/>
                <Button Grid.Column="2" Content="{s:Tr 'همین حالا', 'Do it now'}" Style="{StaticResource BtnDanger}" HorizontalAlignment="Stretch" Padding="12,11" Click="OnNow"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
