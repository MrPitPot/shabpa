<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="clr-namespace:Shabpa.Kit">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Shabpa;component/Kit/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes (Bg, Panel, Text, Accent, CardFill, CardRim, HueA...) are added by Ui.Resources() from the chosen Palette. -->

    <FontFamily x:Key="Ui">/Shabpa;component/Fonts/#Vazirmatn, Segoe UI</FontFamily>
    <FontFamily x:Key="Num">/Shabpa;component/Fonts/#Vazirmatn, Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <kit:SpringEase x:Key="Spring"/>

    <LinearGradientBrush x:Key="PrimaryRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- ===== Text (type scale of the design: H1 27/700, section 14/700, body 13.5, label 12.5) ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="40"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="24"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="4,22,4,10"/>
    </Style>
    <Style x:Key="Tip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <!-- ===== Surfaces ===== -->
    <!-- Flat acrylic card (no outer shadow). For the shadowed top-level card use kit:GlassCard / Ui2.Card. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="22,20"/>
    </Style>
    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Secondary / danger: translucent face, rim light, cheap layered shadow. Hover lift and press come from kit:Fx (spring). -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="root">
            <kit:Shadow Radius="12" Blur="16" Spread="-7" OffsetY="7" Layers="8" Color="{DynamicResource ShadowSoftC}" IsHitTestVisible="False"/>
            <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="glow" Background="{DynamicResource Hi}" Opacity="0" IsHitTestVisible="False"
                    CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Icon-only / ghost buttons: no shadow. -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="root">
            <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="10"/>
            <Border x:Name="glow" Background="{DynamicResource Line}" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Primary: accent gradient, top rim light, accent glow, and a sheen that sweeps across on hover. -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="root">
            <kit:Shadow Radius="12" Blur="20" Spread="-8" OffsetY="8" Layers="14" Color="{DynamicResource AccentGlowC}" IsHitTestVisible="False"/>
            <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border BorderBrush="{StaticResource PrimaryRim}" BorderThickness="1" IsHitTestVisible="False"
                    CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="sheen" IsHitTestVisible="False" CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="sheenT" X="-1.3"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.65"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="sheenT" Storyboard.TargetProperty="X" From="-1.3" To="1.3" Duration="0:0:0.7" FillBehavior="Stop">
                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Card2Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="kit:Skin.Corner" Value="12"/>
        <Setter Property="kit:Fx.Lift" Value="2"/>
        <Setter Property="kit:Fx.Press" Value="0.96"/>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style x:Key="BtnBig" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Padding" Value="22,13"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource RedSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RedLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource Red}"/>
    </Style>
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="kit:Fx.Lift" Value="0"/>
    </Style>

    <!-- ===== Selectable things: chips, segments (use kit:Segmented for the sliding pill), tiles, day toggles ===== -->
    <ControlTemplate x:Key="ToggleTemplate" TargetType="ToggleButton">
        <Grid x:Name="root">
            <Border x:Name="bg" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="sel" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    CornerRadius="{Binding (kit:Skin.Corner), RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Card2Fill}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="sel" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" FillBehavior="Stop"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ToggleBase" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource ToggleTemplate}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="kit:Skin.Corner" Value="15"/>
        <Setter Property="kit:Fx.Press" Value="0.95"/>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource ToggleBase}"/>

    <!-- Checkbox chip: box with a drawn tick, in a pill. For a settings row use kit:Switch instead. -->
    <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource ToggleBase}">
        <Setter Property="Padding" Value="12,8,15,8"/>
        <Setter Property="kit:Skin.Corner" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"/>
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="6" BorderBrush="{DynamicResource Faint}" BorderThickness="1.5"
                                    Margin="0,0,9,0" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="fill" Background="{DynamicResource AccentGradient}" CornerRadius="4" Opacity="0" Margin="-1.5" RenderTransformOrigin="0.5,0.5"/>
                                    <!-- never mirrored (LeftToRight is forced inside), draws from the left short stroke to the top right -->
                                    <kit:TickMark x:Name="tick" Width="12" Height="12" Weight="2.6" Foreground="{DynamicResource White}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  PopTarget="{Binding ElementName=fill}"
                                                  IsOn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Card2Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="fill" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch (design .tg). The knob spring and the press stretch live in kit:Switch. -->
    <Style x:Key="Switch" TargetType="kit:Switch">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="kit:Switch">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0" RecognizesAccessKey="False"/>
                        <Grid Grid.Column="1" Width="42" Height="22" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="11" Background="{DynamicResource Line}" BorderBrush="{DynamicResource Faint}" BorderThickness="1.5"/>
                            <Border x:Name="fill" CornerRadius="11" Background="{DynamicResource AccentGradient}" Opacity="0"/>
                            <Border x:Name="PART_Knob" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource Faint}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5.5,0,0,0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fill" Property="Opacity" Value="1"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="PART_Knob" Property="Background" Value="{DynamicResource White}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Day" TargetType="ToggleButton" BasedOn="{StaticResource ToggleBase}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="kit:Skin.Corner" Value="11"/>
    </Style>
    <Style x:Key="Tile" TargetType="RadioButton" BasedOn="{StaticResource ToggleBase}">
        <Setter Property="Padding" Value="16,18"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="kit:Skin.Corner" Value="16"/>
        <Setter Property="kit:Fx.Lift" Value="2"/>
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource ToggleBase}">
        <Setter Property="Padding" Value="4,11"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="kit:Skin.Corner" Value="12"/>
    </Style>
    <!-- Flat tab for a sliding-thumb track (TabsPage draws the one thumb behind the row, like kit:Segmented). -->
    <Style x:Key="SegTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="kit:Fx.Press" Value="0.95"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar navigation row (the sliding pill is one element in MainWindow; Tag = icon name from Icons.xaml) ===== -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="kit:Fx.Nudge" Value="3"/>
        <Setter Property="kit:Fx.Press" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                            <kit:Icon x:Name="ico" Glyph="{TemplateBinding Tag}" Width="20" Height="20"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text input ===== -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="b" Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"/>
                        <Border x:Name="ring" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Same field for a PasswordBox (Support's owner key): fill, rim, accent ring on focus. -->
    <Style x:Key="InputPass" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="b" Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"/>
                        <Border x:Name="ring" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Width" Value="74"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="MaxLength" Value="2"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <!-- ===== Progress: 8 px track, accent gradient fill (give Foreground a colour brush for a plain tint, or WarnGradientH) ===== -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentGradientH}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{DynamicResource Line}" CornerRadius="4"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BarWarn" TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
        <Setter Property="Foreground" Value="{DynamicResource WarnGradientH}"/>
    </Style>

    <!-- ===== Slider: 4 px track, accent fill, 20 px knob that grows on hover ===== -->
    <Style x:Key="SlideThumb" TargetType="Thumb">
        <Setter Property="kit:Fx.Grow" Value="1.15"/>
        <Setter Property="kit:Fx.Press" Value="1.25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20">
                        <kit:Shadow Radius="10" Blur="8" Spread="-3" OffsetY="3" Layers="4" Color="{DynamicResource ShadowSoftC}" IsHitTestVisible="False"/>
                        <Ellipse Fill="{DynamicResource Card2Fill}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
                        <Ellipse Fill="{DynamicResource Hi}" Margin="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SlideFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SlideRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Line}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slide" TargetType="Slider">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="kit:SliderDrag.Enabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" FlowDirection="LeftToRight" VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlideFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlideThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlideRest}" Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars: thin, rounded, vertical and horizontal ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollBrush}" CornerRadius="3" Margin="2" MinHeight="30" MinWidth="6"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template" Value="{StaticResource VBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template" Value="{StaticResource HBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource FlyoutFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
