  "notes": { "fa": "\ud83d\udce3 \u0634\u0628\u200c\u067e\u0627 \u06f3\u066b\u06f1\u06f9 \u0645\u0646\u062a\u0634\u0631 \u0634\u062f\n\n\ud83c\udd95 \u062a\u0627\u0632\u0647\u200c\u0647\u0627\n\u2022 \ud83d\udd17 \u0634\u0628\u200c\u067e\u0627 \u062f\u06cc\u06af\u0647 \u0627\u0632 \u06af\u06cc\u062a\u200c\u0647\u0627\u0628 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0647\u061b \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0648 \u0644\u06cc\u0646\u06a9\u200c\u0647\u0627 \u0627\u0632 \u06a9\u062f\u0628\u0631\u06af \u0648 \u06af\u06cc\u062a\u200c\u0644\u0628 (\u0648 \u0633\u0627\u06cc\u062a \u0634\u0628\u200c\u067e\u0627 \u0648 \u0622\u0631\u0648\u0627\u0646) \u0645\u06cc\u0627\u0646.\n\u2022 \ud83e\udeb5 \u0627\u06af\u0647 \u0628\u0639\u062f \u0627\u0632 \u0645\u062f\u062a\u06cc \u0645\u062e\u0641\u06cc \u0628\u0648\u062f\u0646 \u067e\u0646\u062c\u0631\u0647 \u06a9\u0646\u062f \u0634\u062f\u060c \u062a\u0648\u06cc \u0644\u0627\u06af \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0647 \u06a9\u0647 \u0686\u0631\u0627.\n\n\u26a1 \u0628\u0647\u0628\u0648\u062f\n\u2022 \u0627\u0648\u0631\u0644\u06cc \u0628\u0627\u0632\u06cc \u0648 \u0631\u0646\u06af \u06af\u0631\u0645 \u0634\u0628 \u062f\u06cc\u06af\u0647 \u0635\u0641\u062d\u0647 \u0631\u0648 \u0686\u0634\u0645\u06a9\u200c\u0632\u0646 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646.\n\u2022 \u067e\u0646\u062c\u0631\u0647\u200c\u06cc \u062a\u0623\u06cc\u06cc\u062f \u0628\u0647 \u067e\u0646\u062c\u0631\u0647\u200c\u06cc \u0627\u0635\u0644\u06cc \u0648\u0635\u0644\u0647 \u0648 \u06af\u0645 \u0646\u0645\u06cc\u200c\u0634\u0647.\n\u2022 \u062d\u0627\u0641\u0638\u0647\u200c\u06cc \u0622\u0632\u0627\u062f \u0634\u062f\u0647\u060c \u0628\u0639\u062f \u0627\u0632 \u0645\u062e\u0641\u06cc \u0634\u062f\u0646 \u0641\u0642\u0637 \u06cc\u06a9 \u0628\u0627\u0631 \u067e\u0627\u06a9 \u0645\u06cc\u200c\u0634\u0647.", "en": "" }
